{
  "name": "snitch",
  "version": "1.0.6",
  "description": "Snitch — real-time network traffic visualizer / visualiseur de trafic réseau en temps réel",
  "main": "main.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "icon": "node generate-icon.js",
    "build": "npm run icon && electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:mac": "npm run icon && electron-builder --mac --arm64",
    "build:linux": "npm run icon && electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snitch.app",
    "productName": "Snitch",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.png",
      "logo.png"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../dist/backend/snitch-backend",
        "to": "snitch-backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend_dist"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Snitch"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "synopsis": "See every connection your computer makes - 100% local",
      "description": "Snitch is a local-first network traffic visualizer: live map of outbound connections, per-process attribution, offline GeoIP. No account, no telemetry.",
      "maintainer": "aiXis Studio",
      "desktopName": "Snitch",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/aixisstudio/Snitch"
}
