{
  "name": "snitch",
  "version": "1.0.4",
  "description": "Snitch — real-time network traffic visualizer / visualiseur de trafic réseau en temps réel",
  "main": "main.js",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "icon": "node generate-icon.js",
    "prebuild": "npm run icon",
    "build": "electron-builder --win --x64",
    "prebuild:dir": "npm run icon",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.snitch.app",
    "productName": "Snitch",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.png",
      "logo.png"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../dist/backend/snitch-backend",
        "to": "snitch-backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend_dist"
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Snitch"
    }
  }
}
